{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "id",
    "pan",
    "bin",
    "cardholderName",
    "expiryDate",
    "status",
    "currencyCode",
    "dailyLimit",
    "monthlyLimit",
    "availableBalance",
    "issuerId",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "pan": { "type": "string", "pattern": "^[0-9]{16}$" },
    "bin": { "type": "string", "pattern": "^[0-9]{6}$" },
    "cardholderName": { "type": "string" },
    "expiryDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "status": { "enum": ["ACTIVE", "INACTIVE", "BLOCKED", "EXPIRED"] },
    "currencyCode": { "type": "string", "pattern": "^[0-9]{3}$" },
    "dailyLimit": { "type": "number" },
    "monthlyLimit": { "type": "number" },
    "availableBalance": { "type": "number" },
    "issuerId": { "type": "string" },
    "createdAt": { "type": "string" }
  }
}
